# =========================================================================
# GCP Cloud Function / Cloud Run Environment Variables
# =========================================================================

# 1. GitHub Personal Access Token (Requires 'repo' and 'workflow' scopes)
GITHUB_PAT=github_pat_your_token_here

# 2. Target GitHub Repository (owner/repo)
# For POC:
GITHUB_REPO=Daxesh-Asint/GitHub-Actions-Trial-2
# For Production:
# GITHUB_REPO=StillSomehowSane/asint_ais

# 3. Fallback Bot Name (Default: Jarvis)
BOT_NAME=Jarvis

# 4. MS Teams Channel Incoming Webhook URL (For Direct Main Feed Responses)
# Set this to your channel's incoming webhook URL (Workflows / Connectors) so
# responses are posted directly into the main channel feed instead of a collapsed thread!
TEAMS_WEBHOOK_URL=https://asint.webhook.office.com/webhookb2/...
